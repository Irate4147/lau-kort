# /etc/lau/lau.env – LAU-serverens indstillinger (læses af systemd: EnvironmentFile). Kun læsbar for root og lau:
#   install -m 640 -o root -g lau server/deploy/lau.env.eksempel /etc/lau/lau.env
# Se server/README.md.

# Sidens adresse (bruges i login-links og kalenderne).
LAU_ADRESSE=https://kort.liberaleunge.dk/
# Hvor data, database, kalendere og sikkerhedskopier ligger.
LAU_VAR=/var/lib/lau
# Serveren lytter kun lokalt; Caddy eller nginx tager sig af HTTPS foran.
HOST=127.0.0.1
PORT=8080
# Apify (scraping af Facebook-begivenheder) – samme token som GitHub-secret APIFY_TOKEN.
APIFY_TOKEN=
# 0 = slå planlagte kørsler fra (fx på en testmaskine).
#LAU_JOBS=0
