{
  "name": "lau-kort",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13"},
  "description": "Kun udviklingsværktøjer – siden og server/ bruger ingen npm-pakker. Intet build-trin: kerne/ er almindelige ES-moduler, der typetjekkes via JSDoc.",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "start": "node --disable-warning=ExperimentalWarning server/lau.js start",
    "typetjek": "tsc -p kerne/jsconfig.json",
    "tjek": "npm run typetjek && npm test"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
